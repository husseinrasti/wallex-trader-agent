# Copy to .env and fill in. Never commit .env.
WALLEX_API_KEY=
WALLEX_BASE_URL=https://api.wallex.ir
WALLEX_WS_URL=wss://api.wallex.ir/connection/websocket
WALLEX_MCP_URL=https://api.wallex.ir/mcp
WALLEX_MCP_AUTH_HEADER=X-API-Key
# Credit (challenge) sub-account: Wallex requires this header for spot orders on a credit account.
# Find it with: python scripts/check_account.py  (lists /sub-accounts)
WALLEX_SUB_ACCOUNT_CLIENT_ID=
OPENROUTER_API_KEY=
OPENROUTER_MODEL_FAST=
OPENROUTER_MODEL_STRONG=
GEMINI_API_KEY=
GEMINI_MODEL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WTA_MODE=shadow
WTA_LIVE=0
CHALLENGE_START_UTC=
CHALLENGE_END_UTC=
INITIAL_EQUITY_TMN=5000000
